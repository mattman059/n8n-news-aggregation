# ─────────────────────────────────────────────────────────────────────────────
# news-pipeline — environment configuration
# Copy this to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── n8n auth ──────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=changeme_strong_password

# Hostname or IP where n8n is reachable (use localhost for local dev)
N8N_HOST=localhost

# ── Timezone ──────────────────────────────────────────────────────────────────
TIMEZONE=America/Chicago

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Claude model to use for scoring and analysis
CLAUDE_MODEL=claude-opus-4-6

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
SHEET_PUBLISHED=Published
SHEET_REVIEW=For Review
SHEET_ARCHIVE=Archive

# ── Scoring thresholds ────────────────────────────────────────────────────────
# Articles at or above SCORE_PUBLISH_MIN get full AI analysis → Published sheet
# Articles at or above SCORE_REVIEW_MIN (but below publish) → For Review sheet
# Articles below SCORE_REVIEW_MIN → Archive sheet
SCORE_PUBLISH_MIN=7
SCORE_REVIEW_MIN=4

# ── Feed Manager ──────────────────────────────────────────────────────────────
# Max articles fetched per poll cycle (across all feeds)
FEED_LIMIT=100

# Poll interval cron (default: every 2 hours)
RSS_POLL_CRON=0 */2 * * *

# ── Redis ─────────────────────────────────────────────────────────────────────
# Password for the Redis instance (used for article deduplication and n8n state)
REDIS_PASSWORD=change_this_redis_password
